# Copy to .env and fill in. .env is gitignored.
# Get all of these at hour 0 — two require a card or an email round-trip,
# and discovering that at 2 AM Saturday is how teams lose the demo.

# Replicate — FLUX.1 Kontext (edit) + TRELLIS (lift). Requires a card.
REPLICATE_API_TOKEN=

# Cesium ion — World Terrain + the viewer. Free, instant signup.
# Also why we can sidestep the geoid correction: ion terrain is already ellipsoidal.
CESIUM_ION_TOKEN=

# Google Geocoding — OPTIONAL. Nominatim is the free fallback.
# Worth 5 minutes for the location_type field (ROOFTOP / APPROXIMATE), which
# feeds the confidence model as the geocode_rooftop feature.
GOOGLE_MAPS_API_KEY=

# Overpass mirror. The public endpoint hands out 429/504 under any load.
OVERPASS_URL=https://overpass-api.de/api/interpreter
